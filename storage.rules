rules_version = '2';

// Firebase Storage rules — Form 101 PDFs, scan sidecars and worker documents
// (contract, visa, work permit) under tenants/{tenantId}/... (docs/backend.md).
// Same identities as firestore.rules (custom-token claims from `login`):
// manager-side logins of the firm read, tenant_admin or staff/hr with the
// 'workers' permission write (saveWorkerFile's requirePermission gate), a
// superadmin can do both for any firm. Suppliers have no direct access.
// An "own workers" hr login (claim own) uploads like a workers writer, with
// its uid in the file's metadata (hrId), and reads back only such files (the
// download URL after an upload); other reads and deletes go through
// users_admin (files.py), which checks the worker's hrId — these rules can't
// see Firestore without a cross-service lookup.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isSuper() { return signedIn() && role() == 'superadmin'; }
    function member(t) { return signedIn() && request.auth.token.tenantId == t; }
    function hrAll(t) { return member(t) && role() == 'hr' && request.auth.token.own != true; }
    function hrMine(t) { return member(t) && role() == 'hr' && request.auth.token.own == true; }
    function manager(t) { return isSuper() || (member(t) && role() in ['tenant_admin', 'staff']) || hrAll(t); }
    // The Workers tab and Edit workers (the flat rights, claim rt; a token
    // signed in before them: the workers section, as before).
    function workersPerm() {
      return (('rt' in request.auth.token) && request.auth.token.rt is list && 'workers' in request.auth.token.rt && 'editWorkers' in request.auth.token.rt)
        || (!('rt' in request.auth.token) && request.auth.token.perms is list
          && (('*' in request.auth.token.perms) || ('workers' in request.auth.token.perms)));
    }
    function workersWriter(t) {
      return isSuper()
        || (member(t) && role() == 'tenant_admin')
        || (member(t) && role() in ['staff', 'hr'] && workersPerm());
    }

    match /tenants/{t}/{path=**} {
      allow read: if manager(t)
        || (hrMine(t) && resource.metadata != null && resource.metadata.hrId == request.auth.uid);
    }
    // Browsers write only worker files. Everything else under a tenant (the
    // client's signed month PDFs, written by the hours function) is
    // server-only — the Admin SDK isn't bound by these rules.
    match /tenants/{t}/workers/{w}/{path=**} {
      allow delete: if workersWriter(t) && (role() != 'hr' || hrAll(t));
      // 25 MB per file is far above a Form 101 PDF or a phone photo.
      // An own-workers hr writes only files stamped with its uid, and never
      // replaces a file stamped by someone else.
      allow create, update: if workersWriter(t) && request.resource.size < 25 * 1024 * 1024
        && (!hrMine(t) || (request.resource.metadata != null && request.resource.metadata.hrId == request.auth.uid
          && (resource == null || (resource.metadata != null && resource.metadata.hrId == request.auth.uid))));
    }
  }
}
