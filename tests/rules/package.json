{
  "name": "schedule-app-rules-tests",
  "private": true,
  "description": "Firestore/Storage security-rules tests and the functions tests (docs/tests.md). Run: npm install && npm test; PYTHON=<venv python with firebase-admin, pytest> npm run test:auth",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project demo-schedule \"node --test rules.test.mjs\"",
    "test:auth": "firebase emulators:exec --only firestore,auth --project demo-schedule \"${PYTHON:-python3} -m pytest ../auth -q\"",
    "test:i18n": "node ../i18n/check.js",
    "test:icons": "node ../icons/check.js",
    "test:design": "node ../design/check.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1"
  }
}
