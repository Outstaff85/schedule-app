rules_version = '2';

// Firestore security rules — see docs/backend.md for the data model.
//
// Sign-in is a custom token from the `login` Cloud Function, whose claims
// carry who the caller is:
//   role      'superadmin' | 'tenant_admin' | 'staff' | 'hr' | 'supplier' | 'client'
//   tenantId  the caller's firm (absent for a superadmin)
//   perms     list of sections a staff or hr login may use, ['*'] = all
//   own       hr only: true = "only own workers" (docs/admin.md → HR)
//   supplierId  only for role 'supplier'
//   clientId    only for role 'client' (the client portal goes through a function too)
//   hp        hr / supplier / client: its hours-review ticks (read by the hours function only)
//   ed        staff / hr on a permission template: what it may change —
//             editSchedule (shifts), editWorkers (worker records),
//             editPunches (punches); absent = all three (a login made before)
//
// These rules mirror the Apps Script checks they replace:
//   - a firm sees only its own data, a superadmin sees every firm;
//   - workers/clients/suppliers/settings are written by tenant_admin or by
//     staff with 'schedule' (saveSchedule's requirePermission gate);
//   - punches: any manager-side login of the firm (savePunch/updatePunch/
//     deletePunch had no role gate); bulk month deletion is a function;
//   - pending hours: anyone of the firm may submit, only tenant_admin or
//     superadmin may approve/reject (requirePendingHoursApprover);
//   - a supplier never reads Firestore directly: wages and GPS can't be
//     hidden field-by-field, so the supplier portal goes through functions
//     that strip them (_stripWorkerForSupplier / _stripClientForSupplier);
//   - an hr login without `own` works like staff with its sections; an hr
//     login with `own` reads and writes only the workers (and their punches,
//     its own pending-hours batches) whose hrId is its uid. No hr login ever
//     changes a worker's hrId — the owner or a superadmin assigns workers;
//     an hr login changes a worker's pay and bank fields only with payEdit,
//     a staff login only with accounting;
//   - users, password hashes, usernames and worker punch-link tokens are
//     function-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isSuper() { return signedIn() && role() == 'superadmin'; }
    function member(t) { return signedIn() && request.auth.token.tenantId == t; }
    function isTenantAdmin(t) { return member(t) && role() == 'tenant_admin'; }
    function isAdmin(t) { return isSuper() || isTenantAdmin(t); }
    function staffCan(t, section) {
      return member(t) && role() == 'staff'
        && request.auth.token.perms is list
        && (('*' in request.auth.token.perms) || (section in request.auth.token.perms));
    }
    // HR logins. hrMine: "only own workers" (claim own); hrAll: sees the firm
    // like staff. hrCan: the login has that section.
    function isHr(t) { return member(t) && role() == 'hr'; }
    function hrMine(t) { return isHr(t) && request.auth.token.own == true; }
    function hrAll(t) { return isHr(t) && request.auth.token.own != true; }
    function hrCan(t, section) {
      return isHr(t) && request.auth.token.perms is list
        && (('*' in request.auth.token.perms) || (section in request.auth.token.perms));
    }
    function uid() { return request.auth.uid; }
    // The edit ticks (claim ed): absent = everything, as before them.
    function mayEd(k) { return !('ed' in request.auth.token) || (k in request.auth.token.ed); }
    // A worker update: with Edit workers anything but the shifts (those too
    // with Edit shifts); with only Edit shifts nothing but the shifts.
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function workerEdOk() {
      return (mayEd('editWorkers') && (mayEd('editSchedule') || !changed().hasAny(['schedule', 'dateShifts'])))
        || (mayEd('editSchedule') && changed().hasOnly(['schedule', 'dateShifts', 'sortIndex']));
    }
    function oldHr() { return resource.data.get('hrId', null); }
    function newHr() { return request.resource.data.get('hrId', null); }
    // Manager-side logins of the firm that see all of its data (never a
    // supplier, never an own-workers hr).
    function manager(t) { return isSuper() || (member(t) && role() in ['tenant_admin', 'staff']) || hrAll(t); }
    function scheduleWriter(t) { return isAdmin(t) || staffCan(t, 'schedule'); }
    // A worker's money: staff changes it only with the accounting section
    // (the owner and a superadmin always may).
    function staffPayOk(t) { return isAdmin(t) || staffCan(t, 'accounting') || samePay(); }
    function staffNewPayOk(t) { return isAdmin(t) || staffCan(t, 'accounting') || noPay(); }
    // An hr login that may write workers: the workers or schedule section;
    // with own, only its own workers.
    function hrWorkers(t) { return hrCan(t, 'workers') || hrCan(t, 'schedule'); }
    // A worker's money (rate, pay mode, OT / Shabbat, travel, bank, per-client
    // rates, days set by hand): an hr login changes it only with payEdit
    // ("Edit own workers' pay"); without it a write must leave every one of
    // these fields as it was (missing and null count as the same).
    function hrPayOk(t) { return hrCan(t, 'payEdit') || samePay(); }
    function samePay() {
      return sameField('hourlyRate') && sameField('regRate') && sameField('otRate')
        && sameField('shabbatRate') && sameField('payMode') && sameField('travelAllowance')
        && sameField('travelMonthly') && sameField('bank') && sameField('bankBranch')
        && sameField('bankAccountNumber') && sameField('clientRates') && sameField('dayOverrides');
    }
    function sameField(k) { return request.resource.data.get(k, null) == resource.data.get(k, null); }
    // A new worker made by an hr login without payEdit carries no money.
    function hrNewPayOk(t) { return hrCan(t, 'payEdit') || noPay(); }
    function noPay() {
      return noField('hourlyRate') && noField('regRate') && noField('otRate')
        && noField('shabbatRate') && noField('payMode') && noField('travelAllowance')
        && noField('travelMonthly') && noField('bank') && noField('bankBranch')
        && noField('bankAccountNumber') && noField('clientRates') && noField('dayOverrides');
    }
    function noField(k) { return request.resource.data.get(k, null) in [null, 0, '', {}]; }

    // Firm profile fields a tenant_admin may edit on their own firm
    // (updateTenant). Activation and counters stay superadmin/function-only.
    function onlyProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['companyName', 'deductionsFileNumber', 'phone', 'street', 'streetNumber', 'city']);
    }

    match /tenants/{t} {
      allow read: if manager(t) || isHr(t);
      allow update: if isSuper() || (isTenantAdmin(t) && onlyProfileFields());
      allow create, delete: if isSuper();

      match /workers/{id} {
        allow read: if manager(t) || (hrMine(t) && oldHr() == uid());
        // Only the owner (or super-admin) assigns a worker to an hr (docs/hr.md).
        allow create: if mayEd('editWorkers') && ((scheduleWriter(t) && staffNewPayOk(t) && (isAdmin(t) || newHr() == null))
          || (hrAll(t) && hrWorkers(t) && (newHr() == null || newHr() == uid()) && hrNewPayOk(t))
          || (hrMine(t) && hrWorkers(t) && newHr() == uid() && hrNewPayOk(t)));
        allow update: if workerEdOk() && ((scheduleWriter(t) && staffPayOk(t) && (isAdmin(t) || newHr() == oldHr()))
          || (hrAll(t) && hrWorkers(t) && newHr() == oldHr() && hrPayOk(t))
          || (hrMine(t) && hrWorkers(t) && oldHr() == uid() && newHr() == uid() && hrPayOk(t)));
        allow delete: if mayEd('editWorkers') && (scheduleWriter(t)
          || (hrAll(t) && hrWorkers(t))
          || (hrMine(t) && hrWorkers(t) && oldHr() == uid()));
      }
      match /clients/{id} {
        allow read: if manager(t) || isHr(t);
        allow write: if scheduleWriter(t) || hrCan(t, 'clients');
      }
      // A supplier's own commission rate (commission, set in the supplier
      // window) is changed only by the firm owner or a superadmin; staff and
      // HR with the section edit everything else and keep it as it is.
      match /suppliers/{id} {
        allow read: if manager(t) || isHr(t);
        allow create: if (scheduleWriter(t) || hrCan(t, 'suppliers'))
          && (isAdmin(t) || request.resource.data.get('commission', null) == null);
        allow update: if (scheduleWriter(t) || hrCan(t, 'suppliers'))
          && (isAdmin(t) || request.resource.data.get('commission', null) == resource.data.get('commission', null));
        allow delete: if scheduleWriter(t) || hrCan(t, 'suppliers');
      }
      match /settings/{id} {
        allow read: if manager(t) || isHr(t);
        allow write: if scheduleWriter(t) || (hrAll(t) && hrCan(t, 'schedule'));
      }
      match /punches/{id} {
        allow read: if manager(t);
        // Written (a manual punch, an edit, a delete) only with Edit punches.
        allow create, update, delete: if manager(t) && mayEd('editPunches');
        // An own-workers hr: the punches stamped with its uid (hrId is set by
        // the punch function, manual punches and approved hours).
        allow read: if hrMine(t) && oldHr() == uid();
        allow delete: if hrMine(t) && oldHr() == uid() && mayEd('editPunches');
        allow create: if hrMine(t) && newHr() == uid() && mayEd('editPunches');
        allow update: if hrMine(t) && oldHr() == uid() && newHr() == uid() && mayEd('editPunches');
      }
      // Hours reviews of client, supplier and HR logins (the `hours` function
      // writes them; managers read them in Accounting). Never written directly.
      match /hourApprovals/{id} {
        allow read: if manager(t);
        allow write: if false;
      }
      // A worker's days off and shift offers (stage 5b): written only by the
      // punch function from the worker's own link. Managers read them (an
      // own-workers hr only its own workers', by hrId); a schedule writer
      // confirms or declines a pending offer, changing nothing but its status
      // and who / when decided (the schedule itself is written as a worker, in
      // the same batch); decidedByUid must be the decider's own uid. The owner
      // reassigning a worker's HR moves its requests' hrId (setPunchesHr).
      match /shiftRequests/{id} {
        allow read: if manager(t) || (hrMine(t) && oldHr() == uid());
        allow update: if (scheduleWriter(t) || (hrAll(t) && hrCan(t, 'schedule'))
            || (hrMine(t) && hrCan(t, 'schedule') && oldHr() == uid()))
          && resource.data.kind == 'swap' && resource.data.status == 'pending'
          && request.resource.data.status in ['confirmed', 'declined']
          && request.resource.data.decidedByUid == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'decidedByUid']);
        allow update: if isAdmin(t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hrId']);
        allow create, delete: if false;
      }
      match /pendingHours/{id} {
        allow read: if manager(t) || (hrMine(t) && resource.data.createdBy == uid());
        // Submitted as pending by the caller themself; nothing reaches payroll
        // until a tenant_admin/superadmin approves it.
        allow create: if (manager(t) || isHr(t))
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAdmin(t);
      }
    }

    // Login profile (role, tenant, permissions). Written only by functions.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper() || isTenantAdmin(resource.data.tenantId));
      allow write: if false;
    }

    // The notifications a manager-side login has read (the bell's "Mark all
    // read"): only its own doc, a list of at most 500 ids.
    match /notifReads/{u} {
      allow read: if signedIn() && request.auth.uid == u && role() in ['superadmin', 'tenant_admin', 'staff', 'hr'];
      allow write: if signedIn() && request.auth.uid == u && role() in ['superadmin', 'tenant_admin', 'staff', 'hr']
        && request.resource.data.keys().hasOnly(['ids', 'at'])
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 500;
    }

    // Function-only: password hashes, the username -> uid index (keeps
    // usernames unique), worker punch-link tokens, push subscriptions.
    match /authSecrets/{uid} { allow read, write: if false; }
    match /usernames/{name} { allow read, write: if false; }
    match /workerTokens/{token} { allow read, write: if false; }
    match /pushSubscriptions/{id} { allow read, write: if false; }
    match /weatherCache/{area} { allow read, write: if false; }  // the weather function only (stage 12)
    match /permTemplates/{id} { allow read, write: if false; }  // the users_admin function only (permission templates)

    // Telemetry: any signed-in caller may append, only a superadmin may read.
    // The super-admin reads them and may wipe them (Admin → Reset).
    match /errors/{id} {
      allow create: if signedIn();
      allow read, delete: if isSuper();
    }
    match /timings/{id} {
      allow create: if signedIn();
      allow read, delete: if isSuper();
    }
  }
}
