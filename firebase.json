{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python312"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "archive/**",
      "*.md",
      "node_modules/**",
      "functions/**",
      "Screenshot_*.jpg",
      "Screenshot_*.png",
      "Tokens/**",
      ".env"
    ],
    "headers": [
      {
        "source": "/service-worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "/**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/", "destination": "/schedule-manager.html" },
      { "source": "/punch", "destination": "/worker-punch.html" },
      { "source": "/supplier", "destination": "/supplier-portal.html" }
    ]
  }
}
