{
  "name": "schedule-app",
  "private": true,
  "description": "The new stack (docs/build.md): React + Vite + TypeScript + Tailwind + shadcn/ui in src/, built with the old pages into dist/ for Firebase Hosting.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build-payroll.mjs --check && vite build && node scripts/copy-static.mjs",
    "build:payroll": "node scripts/build-payroll.mjs",
    "preview": "vite preview",
    "check:build": "node tests/build/check.js",
    "test:payroll": "node tests/payroll/compare.test.mjs",
    "test:accounting": "node tests/accounting/compare.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "motion": "^14.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
